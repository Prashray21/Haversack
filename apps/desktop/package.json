{
  "name": "@haversackhq/desktop",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Haversack desktop app — local mode first (PRD v0.3); architecture per docs/adr/001 rev 2.",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc -p . && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@haversackhq/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vite": "8.3.6"
  },
  "pnpm": {
    "overrides": {
      "electron-builder-squirrel-windows": "-"
    }
  }
}
